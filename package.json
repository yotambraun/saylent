{
  "name": "saylent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source audit of what AI assistants say about your brand, with the receipts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yotambraun/saylent.git"
  },
  "homepage": "https://yotambraun.github.io/saylent/",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check-env": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/check-env.ts",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/apply-migrations.ts",
    "app:local": "node scripts/app-local.mjs",
    "test": "vitest run",
    "cli": "tsx packages/cli/src/index.ts",
    "build:report-assets": "tsx packages/report/scripts/build-report-assets.ts",
    "build:cli": "npm run build:report-assets && node packages/cli/scripts/build.mjs",
    "build:action": "node packages/action/scripts/build.mjs",
    "build:packages": "npm run build --workspace=packages/engine && npm run build --workspace=packages/report",
    "media": "node scripts/media/index.mjs",
    "site:dev": "npm run dev --workspace=website",
    "site:build": "node scripts/copy-kestrel-sample.mjs && npm run build --workspace=website",
    "dev:wsl": "WATCHPACK_POLLING=true next dev",
    "check:report": "node scripts/check-report-html.mjs examples/kestrel/report.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@google/genai": "^2.10.0",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.11.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.4",
    "openai": "^6.45.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
