# ============================================================
# Saylent env template. Copy to .env.local (gitignored, never commit).
# Three tiers below: the CLI needs only the first; the full app needs the
# second and, optionally, the third. See
# https://yotambraun.github.io/saylent/docs/self-host/environment for
# "required for" / "default" / "what breaks without it" on every variable.
# ============================================================

# --- CLI (all you need for `npx saylent audit <domain>`) --------------------

# required (one of these two): judge family + ChatGPT engine
OPENAI_API_KEY=

# required (one of these two): brand model, drafter, judge family + Claude engine
ANTHROPIC_API_KEY=

# optional engine
GEMINI_API_KEY=

# optional engine (no free key-test call; the key format is validated instead)
PERPLEXITY_API_KEY=

# smoke (6 questions; about $0.60 to $1.20 with four engines, and our two
# recorded runs cost $0.93 and $1.11) or full (23 questions x 4 engines; about
# $3.70 to $5.50). The CLI defaults to smoke; the self-hosted app runs the full
# profile by default and shows the estimate before every run.
AUDIT_PROFILE=smoke

# crawler UA override, e.g. "Mozilla/5.0 (compatible; MyAudit/1.0; +https://example.com/crawler)"
# (default: SaylentAudit/<version> (+https://yotambraun.github.io/saylent/docs/crawler))
SAYLENT_USER_AGENT=

# your own domain, labels the diagnostic UA on the live per-bot probe
# (empty = omit "+<url>")
SAYLENT_APP_DOMAIN=

# --- Full app: required -----------------------------------------------------

# canonical origin the app is served from
NEXT_PUBLIC_APP_URL=

# canonical site origin for layout/sitemap/robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# product name shown in the UI, emails, and the Inngest app id (default "Saylent")
NEXT_PUBLIC_APP_NAME=

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# the sb_publishable_... key, from the "Publishable and secret API keys" tab,
# NOT the legacy tab
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# the sb_secret_... key (click the eye icon, then copy), same tab as above
SUPABASE_SERVICE_ROLE_KEY=

# "Transaction pooler" connection string (port 6543), used by the app at runtime
DATABASE_URL=

# "Direct connection" string (port 5432), used for migrations only
DIRECT_DATABASE_URL=

# prod only; local dev needs neither Inngest key (`npx inngest-cli dev` reads none)
INNGEST_EVENT_KEY=

# prod only, required in production so /api/inngest is authenticated
INNGEST_SIGNING_KEY=

# optional but recommended (see the self-host environment docs above): the
# pgcrypto passphrase that encrypts provider API keys saved from /admin/providers,
# so an operator can change a key or a per-role model with NO redeploy.
# Generate with: openssl rand -hex 32 (min 16 chars). Unset = keys are
# environment-only and the console says so; models stay editable either way.
# It is NEVER stored in the database: losing or changing it makes every
# console-saved key unreadable (re-enter them). Env keys always win.
APP_SECRET=

# --- Full app: optional -----------------------------------------------------

# the legal entity or person operating this deployment, printed on /privacy and
# /terms. Leave it unset and those two pages refuse to render a policy and say
# so; they never publish a policy attributed to nobody
NEXT_PUBLIC_OPERATOR_NAME=

# correction/support address shown on public pages and error pages
# (default hello@example.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# transactional email (welcome, report-ready, movement, verify reminder),
# inert without it
RESEND_API_KEY=

# required alongside RESEND_API_KEY
EMAIL_FROM=

# set to force the Inngest SDK's local-dev mode outside its own auto-detection
INNGEST_DEV=

# server + edge DSN; all Sentry vars are inert until this is set
SENTRY_DSN=

# client/browser DSN (must be NEXT_PUBLIC_ to reach the browser bundle)
NEXT_PUBLIC_SENTRY_DSN=

# source-map upload at build (Sensitive in Vercel)
SENTRY_AUTH_TOKEN=

SENTRY_ORG=
SENTRY_PROJECT=

# performance trace sampling 0-1 (default 0.2 in prod, 0 elsewhere)
SENTRY_TRACES_SAMPLE_RATE=

# points /demo at a real consented run instead of the illustrative sample
DEMO_RUN_ID=

# brand-count cap per account, no separate plan tiers (default 5)
BRAND_LIMIT=

# per-brand rolling-window throttle on manual runs
# (defaults: 24h, 3 audits, 3 verifies)
RUN_THROTTLE_WINDOW_HOURS=
RUN_THROTTLE_AUDITS=
RUN_THROTTLE_VERIFIES=

# global daily provider-spend ceiling in USD; crossing it trips the kill switch
# (default 20)
DAILY_SPEND_CAP_USD=

# transactional email sending kill switch (default on; belt over the
# RESEND_API_KEY guard)
FLAG_EMAILS=

# scheduled runs: weekly verify + monthly audit crons (default off; an operator
# setting, not a plan). The pre-rename env name is still honored as an alias for
# one release, see src/lib/flags.ts
FLAG_SCHEDULED_RUNS=

# CSP enforcement kill switch (default on; set 0 to fall back to Report-Only)
FLAG_CSP_ENFORCE=

# CoVe evidence-audit pass over each drafted artifact
# (default off; ~1 extra call per artifact when on)
FLAG_COVE_AUDIT=

# model registry overrides (packages/engine/src/models.ts has the defaults),
# leave empty
MODEL_CHATGPT_ANSWER=
MODEL_CLAUDE_ANSWER=
MODEL_GEMINI_ANSWER=
MODEL_PERPLEXITY_ANSWER=
MODEL_JUDGE_ANTHROPIC=
MODEL_JUDGE_OPENAI=
MODEL_BRAND=
MODEL_DRAFTER=

# single-provider mode (OpenAI key only): the brand model and drafter run on
# these instead
MODEL_BRAND_OPENAI=
MODEL_DRAFTER_OPENAI=

# --- Own-server target (Docker) and build-only knobs; not needed on Vercel
# or locally ---

# set to 1 only when building the Docker image (enables Next standalone output)
NEXT_OUTPUT_STANDALONE=

# self-hosted Inngest in docker-compose (the app talks to the inngest service)
INNGEST_BASE_URL=

# docker-compose host ports (defaults 3000 and 8288)
APP_PORT=
INNGEST_PORT=

# which login methods the sign-in page shows: password,magic-link,google
# (default password,magic-link)
NEXT_PUBLIC_AUTH_METHODS=

# --- The docs website's own instant check (website/, a separate npm workspace;
# not read by the main app) ---

# base URL of the separately deployed services/instant-check service, e.g.
# https://check.example.com (default unset: the home-page widget degrades to
# printing the `saylent gate-check` command instead of a broken input)
NEXT_PUBLIC_INSTANT_CHECK_URL=

# --- Hosted read-only demo (see the self-host environment docs above; leave
# ALL of these empty on a normal deployment, unset means the demo does not
# exist and nothing changes) ---

# 1 turns the whole deployment into the public read-only demo: an unauthenticated
# visitor to /app is signed in as the shared demo account below, a banner says so,
# and EVERY write (settings, brands, fixes, shares, support, account delete/export
# and createRun, so every LLM call) is refused. $0 per visitor.
NEXT_PUBLIC_DEMO_READONLY=

# the shared demo account the proxy signs visitors in as. Create or repair it with
# `npx tsx --tsconfig scripts/tsconfig.json scripts/seed-demo.ts`, which also seeds
# the Kestrel Uptime fixture as its brand + finished run. Server-only; a throwaway
# account on a throwaway Supabase project (it is demoted to role=user on every seed).
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# where the demo banner's "Read the docs" link points (default: the public docs site)
NEXT_PUBLIC_DEMO_DOCS_URL=
